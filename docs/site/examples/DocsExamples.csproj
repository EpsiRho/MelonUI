<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MelonUI.DocsExamples</AssemblyName>
    <MelonUIRoot Condition="'$(MelonUIRoot)' == ''">$(MSBuildThisFileDirectory)../../../</MelonUIRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MelonUIRoot)/MelonUI/MelonUI.csproj"/>
    <ProjectReference Include="$(MelonUIRoot)/MelonUIBindingGenerator/MelonUIBindingGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>
</Project>
