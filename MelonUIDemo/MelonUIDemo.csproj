<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pages\DemoMenu.xml" />
    <None Update="Pages\Controls.xml" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\MelonUI\MelonUI.csproj" />
    <ProjectReference Include="..\MelonUI.Shaders\MelonUI.Shaders.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Pages\DemoPage.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Pages\DemoWelcome.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Pages\TestingPage.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
